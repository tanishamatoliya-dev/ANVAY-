# ANVAY Practice Management Environment Configuration

# Server & Runtime
PORT=3000
APP_URL=http://localhost:3000

# Database (MongoDB Atlas connection string)
# Optional: If unset, ANVAY operates in standalone mode with built-in persistence.
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/anvay?retryWrites=true&w=majority
MONGO_URI=

# Authentication
JWT_SECRET=anvay_super_secure_jwt_secret_production_key_2026

# Payment Gateway (Razorpay)
# Optional: If unset, ANVAY provides seamless test mode with verified signature generation.
RAZORPAY_KEY_ID=rzp_test_anvaydemo123456
RAZORPAY_KEY_SECRET=rzp_secret_anvaydemoSecretKey123456

# Frontend Public Keys
VITE_RAZORPAY_KEY_ID=rzp_test_anvaydemo123456
VITE_API_BASE_URL=/api

# Google Gemini AI (Injected automatically in AI Studio or configured in production)
GEMINI_API_KEY=
