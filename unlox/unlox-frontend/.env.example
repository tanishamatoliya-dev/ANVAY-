# UNLOX Practice Management Environment Configuration

# Server & Runtime
PORT=3000
APP_URL=http://localhost:3000

# Database (MongoDB Atlas connection string)
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/unlox?retryWrites=true&w=majority
MONGO_URI=

# Authentication
JWT_SECRET=unlox_super_secure_jwt_secret_production_key_2026

# Payment Gateway (Razorpay)
# Backend secret keys - NEVER exposed to browser
RAZORPAY_KEY_ID=rzp_test_unloxdemo123456
RAZORPAY_KEY_SECRET=rzp_secret_unloxdemoSecretKey123456

# Frontend Public Keys (Starts with VITE_)
VITE_RAZORPAY_KEY_ID=rzp_test_unloxdemo123456
VITE_API_BASE_URL=/api

# Google Gemini AI (Injected automatically in AI Studio or configured in production)
GEMINI_API_KEY=
